# Gemini is the default. Use a Free tier AI Studio project with billing disabled.
# Export these in your terminal/server environment; .env is not auto-loaded.
# Never put an API key in browser JavaScript or commit a populated .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PITWALL_LLM_PROVIDER=gemini
# Explicit paid-provider opt-in only: set PITWALL_LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
PORT=8001
